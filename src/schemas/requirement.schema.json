{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Requirement",
  "type": "object",
  "required": ["id", "title", "status"],
  "properties": {
    "id": { "type": "string", "pattern": "^R-[0-9]+$" },
    "title": { "type": "string" },
    "description": { "type": "string" },
    "status": { "type": "string", "enum": ["VERIFIED","IMPLEMENTED","PARTIALLY_IMPLEMENTED","NOT_IMPLEMENTED","FAILED","UNKNOWN","ASSUMED","INFERRED","STALE","CONFLICTING"] },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["type", "source", "kind"],
        "properties": {
          "type": { "type": "string", "enum": ["CODE","TEST","RUNTIME","GIT","COMMAND","RESEARCH","INFERENCE","DOCUMENTATION"] },
          "source": { "type": "string" },
          "kind": { "type": "string", "enum": ["FACT","INFERENCE","ASSUMPTION","OPINION","UNVERIFIED"] },
          "details": { "type": "string" }
        }
      }
    },
    "files": { "type": "array", "items": { "type": "string" } },
    "risk": { "type": "string", "enum": ["TRIVIAL","LOW","MEDIUM","HIGH","CRITICAL"] },
    "createdAt": { "type": "string" }
  }
}
